name			calendar
version			@VERSION@-@REVISION@
architecture		@ARCHITECTURE@
summary			"A native calendar application for Haiku"
description		"Calendar manages appointments using native Haiku files, attributes and queries. It provides day, week and month views, categories, reminders and recurring events."
packager		"sikosis"
vendor			"Calendar contributors"
licenses {
	"MIT"
}
copyrights {
	"2017 Akshay Agarwal"
	"2017-2021 HaikuArchives Team"
	"2026 Calendar contributors"
}
urls {
	"https://github.com/sikosis/Calendar"
}
source-urls {
	"https://github.com/sikosis/Calendar"
}
provides {
	calendar = @VERSION@
	app:Calendar = @VERSION@
}
requires {
	@HAIKU_REQUIREMENT@
}
